<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    
    <!-- Google Fonts: Nghệ thuật & Tinh tế -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Dancing+Script:wght@500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="romantic-theme">
    <!-- Ambient Animated Background Lights -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>

    <!-- Canvas cho hiệu ứng Cánh hoa & Bụi sao bay lung linh -->
    <canvas id="petalsCanvas"></canvas>

    <!-- Âm nhạc nền lãng mạn -->
    <audio id="bgAudio" src="/audio/the_mountain-love-591389.mp3" loop preload="auto"></audio>

    <!-- Header Actions (Âm thanh & Toàn màn hình) -->
    <div class="top-controls">
        <button id="musicToggleBtn" class="control-btn" title="Bật/Tắt nhạc nền lãng mạn">
            <i class="fas fa-music"></i>
            <span class="btn-text">Giai điệu</span>
        </button>
        <button id="fullscreenBtn" class="control-btn" title="Toàn màn hình">
            <i class="fas fa-expand"></i>
        </button>
    </div>

    <!-- Không gian chính: Phong bì thư & Chiếc thiệp -->
    <main class="scene-viewport" id="sceneViewport">
        <!-- Vòng hào quang phía sau -->
        <div class="scene-aura"></div>

        <!-- 1. PHONG BÌ THƯ SANG TRỌNG (ENVELOPE) -->
        <div class="envelope-container" id="envelopeContainer">
            <div class="envelope-box" id="envelopeBox">
                <!-- Mặt sau phong bì -->
                <div class="env-back"></div>
                
                <!-- Mô phỏng mẩu thiệp nằm sẵn bên trong phong bì -->
                <div class="env-letter-peek"></div>

                <!-- Các nếp gấp mặt trước phong bì -->
                <div class="env-pocket"></div>
                <div class="env-fold-left"></div>
                <div class="env-fold-right"></div>
                <div class="env-fold-bottom"></div>

                <!-- Nắp phong bì có thể lật mở 3D -->
                <div class="env-flap" id="envFlap">
                    <div class="env-flap-inner"></div>
                    <!-- Con dấu sáp niêm phong hoa hồng mạ vàng -->
                    <div class="wax-seal" id="waxSeal">
                        <div class="seal-glow"></div>
                        <div class="seal-badge">
                            <span class="seal-emoji">🌸</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. CHIẾC THIỆP 3D SIÊU THỰC (TỪ TỪ HIỆN LÊN VÀ CÓ THỂ CUỘN NỘI DUNG) -->
        <div class="card-wrapper" id="cardWrapper">
            <!-- Nút đóng/gấp thiệp lại vào phong bì đáng yêu -->
            <button class="cute-fold-btn" id="closeCardBtn" title="Gấp thiệp lại cất vào phong bì nè">
                <span class="cute-btn-icon">🎀</span>
                <span class="cute-btn-text">Gấp thiệp lại nè</span>
                <span class="cute-btn-heart">💕</span>
            </button>

            <div class="romantic-card" id="romanticCard">
                <!-- Hiệu ứng phản chiếu ánh sáng lướt qua mặt kính -->
                <div class="card-shine"></div>

                <!-- Họa tiết hoa văn góc mạ vàng -->
                <div class="corner-ornament top-left">
                    <svg viewBox="0 0 60 60" fill="none">
                        <path d="M5 55 C 5 25, 25 5, 55 5" stroke="url(#goldGradient)" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="5" cy="55" r="3" fill="#fbd786"/>
                        <circle cx="55" cy="5" r="3" fill="#fbd786"/>
                        <path d="M12 45 C 12 25, 25 12, 45 12" stroke="rgba(255, 215, 0, 0.4)" stroke-width="1.2" stroke-dasharray="2 3"/>
                        <defs>
                            <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#fff2a1"/>
                                <stop offset="50%" stop-color="#e2a578"/>
                                <stop offset="100%" stop-color="#f7797d"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="corner-ornament top-right">
                    <svg viewBox="0 0 60 60" fill="none">
                        <path d="M5 5 C 35 5, 55 25, 55 55" stroke="url(#goldGradient)" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="5" cy="55" r="3" fill="#fbd786"/>
                        <circle cx="55" cy="55" r="3" fill="#fbd786"/>
                        <path d="M15 12 C 35 12, 48 25, 48 45" stroke="rgba(255, 215, 0, 0.4)" stroke-width="1.2" stroke-dasharray="2 3"/>
                    </svg>
                </div>
                <div class="corner-ornament bottom-left">
                    <svg viewBox="0 0 60 60" fill="none">
                        <path d="M5 5 C 5 35, 25 55, 55 55" stroke="url(#goldGradient)" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="5" cy="55" r="3" fill="#fbd786"/>
                        <circle cx="55" cy="55" r="3" fill="#fbd786"/>
                    </svg>
                </div>
                <div class="corner-ornament bottom-right">
                    <svg viewBox="0 0 60 60" fill="none">
                        <path d="M55 5 C 55 35, 35 55, 5 55" stroke="url(#goldGradient)" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="55" cy="5" r="3" fill="#fbd786"/>
                        <circle cx="55" cy="55" r="3" fill="#fbd786"/>
                    </svg>
                </div>

                <!-- PHẦN THÂN THIỆP CÓ THỂ CUỘN ĐỌC NỘI DUNG (SCROLLABLE CARD BODY) -->
                <div class="card-scroll-body" id="cardScrollBody">
                    <!-- Tiêu đề nghệ thuật lấp lánh -->
                    <h1 class="card-headline">
                        <span class="script-accent">Happy</span>
                        <span class="gold-gradient-text">20 • 10</span>
                    </h1>

                    <div class="decorative-separator">
                        <span class="line line-left"></span>
                        <span class="flower-center">❦ ✦ ❦</span>
                        <span class="line line-right"></span>
                    </div>

                    <!-- Khu vực hiển thị lời chúc trọng tâm -->
                    <div class="card-wish-container">
                        <div class="quote-mark quote-start">“</div>
                        <div class="wish-text" id="wishText">
                            <% 
                                const paragraphs = message.split(/\n\s*\n/);
                                paragraphs.forEach((para, idx) => { 
                            %>
                                <p class="wish-para <%= idx === 0 ? 'wish-para-lead' : '' %>"><%= para %></p>
                            <%  }); %>
                        </div>
                        <div class="quote-mark quote-end">”</div>
                    </div>

                    <!-- Dấu ấn thơ mộng cuối thiệp -->
                    <div class="card-footer-seal">
                        <div class="seal-flower">💐</div>
                        <p class="seal-caption">Mãi luôn rạng ngời & tràn đầy hạnh phúc</p>
                        <div class="sparkle-row">
                            <span>✨</span>
                            <span>💕</span>
                            <span>✨</span>
                        </div>
                    </div>
                </div>

                <!-- Chỉ dẫn có thể cuộn (hiện nhẹ nếu nội dung dài) -->
                <div class="scroll-indicator" id="scrollIndicator">
                    <i class="fas fa-chevron-down"></i>
                </div>
            </div>
        </div>
    </main>

    <!-- Scripts hiệu ứng & tương tác -->
    <script src="/js/main.js"></script>
</body>
</html>
